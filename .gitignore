# Secrets — the most important lines here
.env
.env.*
*.key

# Generated by a run
tradewatch.db
*.db
*.sqlite3
briefs/
run.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/

# Tooling
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store

# The shipped snapshot, re-included last so nothing above can re-ignore it —
# a negation only wins if no later rule matches the path again, and *.db is
# stated twice in most gitignores that grow organically.
#
# It is checked in because nothing writes to it at runtime. A read-only
# database is not state; it is a static asset that happens to be in SQLite
# format, and shipping it inside the image is what makes ephemeral disk
# irrelevant.
!data/snapshot.db
